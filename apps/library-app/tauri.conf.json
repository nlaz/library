{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Library",
  "version": "0.1.3",
  "identifier": "dev.thelibrary",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "The Library",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' pages: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ocr:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCOTU3RkU3MkZEOURGQzYKUldURzM5a3Y1MytWeTBLZ2FIOWxoRUNmVzBoMzQxS3IvS2RQL2ZWcmFaWmF6dkR5VTFzNS9CM3QK",
      "endpoints": [
        "https://github.com/nlaz/library/releases/latest/download/latest.json"
      ]
    }
  }
}